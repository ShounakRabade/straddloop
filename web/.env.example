# Supabase project (Project settings > API). Both values are safe to expose to the browser;
# row-level security in supabase/schema.sql is what protects the data.
# The URL must start with https:// and end in .supabase.co (not the dashboard link).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
