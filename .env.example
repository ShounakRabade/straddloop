# Copy to .env (which Git ignores) and fill in. Never commit the real file.

# Where Straddloop keeps market data, raw API responses and run outputs.
STRADDLOOP_HOME=./data

# Dhan Data API (₹499/month plan). Client ID and a current access token from web.dhan.co.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Requests per second to Dhan's data APIs. Dhan documents 5/s; 4 leaves headroom.
DHAN_REQUESTS_PER_SECOND=4
